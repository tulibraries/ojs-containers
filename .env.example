### Image / OJS version --------------------------------------------------------
IMAGE_SOURCE=local
PKP_TOOL=ojs
PKP_VERSION="3_4_0-9"
WEB_SERVER="alpine:3.24"

### Database --------------------------------------------------------------------
DB_VERSION="mariadb:11.8"
DB_HOST="db"
DB_NAME="journal_name"
DB_USER="ojs"
DB_PASS="replace-with-a-local-password"
DB_DUMP_FILE="journal_db_dump.sql"
OJS_CONFIG_FILE="./volumes/config/journal.config.inc.php"

### Project ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME="journal-name"
PROJECT_DOMAIN="journal-name.localhost"
SERVERNAME="$PROJECT_DOMAIN"

### Local web ports -------------------------------------------------------------
HTTP_PORT=8080
HTTPS_PORT=8443

### Runtime/build settings ------------------------------------------------------
WEB_USER="www-data"
WEB_PATH="/var/www/html/ojs"
HTTPS=On

### Derived database variables --------------------------------------------------
MYSQL_USER="${DB_USER}"
MYSQL_DATABASE="${DB_NAME}"
MYSQL_PASSWORD="${DB_PASS}"
MYSQL_ROOT_PASSWORD="${DB_PASS}"

### OJS variables ---------------------------------------------------------------
PKP_CLI_INSTALL=0
PKP_CONFIG_SYNC=0
PKP_INSTALLED=On
PKP_DB_DRIVER=mysqli
PKP_DB_HOST="${DB_HOST}"
PKP_DB_NAME="${DB_NAME}"
PKP_DB_USER="${DB_USER}"
PKP_DB_PASSWORD="${DB_PASS}"
PKP_WEB_CONF="/etc/apache2/conf.d/pkp.conf"
PKP_CONF="/var/www/html/ojs/config.inc.php"

### Build variables -------------------------------------------------------------
BUILD_PKP_APP_OS="alpine:3.24"
BUILD_PKP_APP_PATH="/app"
